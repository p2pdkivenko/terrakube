<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="mfa-1" author="terrakube">
        <createTable tableName="user_mfa_settings">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_email" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="mfa_enabled" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="preferred_method" type="varchar(64)"/>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar2(128)"/>
            <column name="updated_by" type="varchar2(128)"/>
        </createTable>
        <rollback>
            <dropTable tableName="user_mfa_settings"/>
        </rollback>
    </changeSet>
    <changeSet id="mfa-2" author="terrakube">
        <createTable tableName="mfa_credential">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="credential_data" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar2(128)"/>
            <column name="updated_by" type="varchar2(128)"/>
            <column name="last_used_date" type="datetime"/>
        </createTable>
        <rollback>
            <dropTable tableName="mfa_credential"/>
        </rollback>
    </changeSet>
    <changeSet id="mfa-3" author="terrakube">
        <createTable tableName="mfa_attempt">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_type" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="success" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="varchar(45)"/>
            <column name="created_date" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="mfa_attempt"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
